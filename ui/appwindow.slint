import { VoiceSayingsWindow, SayingRow } from "sayings.slint";
export { VoiceSayingsWindow, SayingRow }
import { DesktopAvatarWindow, DesktopAvatarSettingsWindow, AvatarSpeechBlock } from "desktop_avatar.slint";
import { CalendarRemindersWindow, ReminderPopover, CalendarAccountRow, CalendarSourceRow, ReminderEventRow } from "reminders.slint";
export { CalendarRemindersWindow, ReminderPopover, CalendarAccountRow, CalendarSourceRow, ReminderEventRow }
export { DesktopAvatarWindow, DesktopAvatarSettingsWindow, AvatarSpeechBlock }
import { GraphRunRow, GraphRunProgress } from "graph_progress.slint";
import { AgentTab, RichMessageBlock, RichTableRow, HermesSettingsWindow, HermesTabSettingsWindow, HermesHiddenTabsWindow } from "hermes.slint";
export { AgentTab, RichMessageBlock, RichTableRow, HermesSettingsWindow, HermesTabSettingsWindow, HermesHiddenTabsWindow }
import { HistorySearchResult, HermesHistoryWindow } from "hermes.slint";
export { HistorySearchResult, HermesHistoryWindow }
import { AvatarPlaygroundWindow } from "avatar_playground.slint";
export { AvatarPlaygroundWindow }
export { GraphRunRow }
import { GraphNodeRow, GraphPortRow, GraphWireRow, GraphSettingRow } from "graph.slint";
export { GraphNodeRow, GraphPortRow, GraphWireRow, GraphSettingRow }
import { PipelineStage, StageEntry, PipelineList, PipelineRow, PipelineCard, PipelinePoolEntry, PipelinePoolRow, PipelinePoolGroup, PipelineEditorWindow, PipelineStepWindow } from "pipelines.slint";
import { ModelManagerWindow, ModelCreatorWindow, ModelRow } from "models.slint";
import { ComponentSetupWindow, ComponentChoice, AgentApprovalWindow, AssistantFile, AssistantChatWindow, AssistantMessage, AssistantPipelineWindow, McpManagerWindow } from "assistant.slint";
export { ComponentSetupWindow, ComponentChoice, AgentApprovalWindow, AssistantFile, AssistantChatWindow, AssistantMessage, AssistantPipelineWindow, McpManagerWindow }
export { PipelineEditorWindow, PipelineStepWindow, PipelineCard, PipelineRow }
export { PipelinePoolEntry, PipelinePoolRow, PipelinePoolGroup }
export { ModelManagerWindow, ModelCreatorWindow, ModelRow }
import { VerticalBox, HorizontalBox, LineEdit, TextEdit, ComboBox, CheckBox, ScrollView, Slider, Palette } from "std-widgets.slint";
component SelectableDocument inherits TextInput {
    font-family: "Arial";
    in-out property <int> selected-bytes;
    cursor-position-changed(position) => { root.selected-bytes = Math.abs(self.cursor-position-byte-offset - self.anchor-position-byte-offset); }
    read-only: true;
    single-line: false;
    wrap: word-wrap;
}
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <color> accent: #4ade80;
    callback clicked();
    height: 32px;
    min-width: caption.preferred-width + (root.icon.width > 0 ? 48px : 28px);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: focus.has-focus ? root.accent : #ffffff20;
    background: !root.enabled ? #ffffff05 : root.primary ? root.accent : area.has-hover ? #ffffff15 : #ffffff08;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    Image { x: 12px; y: 8px; width: root.icon.width > 0 ? 16px : 0px; height: 16px; source: root.icon; colorize: root.primary ? #07140e : #edf5f0; }
    caption := Text { x: root.icon.width > 0 ? 36px : 12px; width: parent.width - self.x - 12px; height: parent.height; text: root.text; color: root.primary ? #07140e : #edf5f0; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    area := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}
component VersionLink inherits Rectangle {
    in property <string> text;
    in property <color> accent;
    callback clicked();
    height: 24px;
    min-width: caption.preferred-width + 8px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;
    border-radius: 3px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: root.accent;
    accessible-role: button;
    accessible-label: "Echo " + root.text + ". Open updates";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    caption := Text { x: 4px; height: parent.height; text: root.text; font-size: 11px; font-weight: 700; color: area.has-hover || focus.has-focus ? root.accent : #a7b8ad; vertical-alignment: center; }
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    area := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
component ResourceValue inherits HorizontalBox {
    in property <string> label;
    in property <string> value;
    padding: 0px; spacing: 4px; horizontal-stretch: 0;
    Text { text: root.label; font-size: 11px; color: #a7b8ad; vertical-alignment: center; }
    Text { text: root.value; font-size: 11px; font-weight: 700; color: #e4ffe9; vertical-alignment: center; }
}
component SettingsNavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> show-label: false;
    in property <color> accent: #4ade80;
    callback activated();
    callback hint-changed(string, length);
    height: 36px;
    width: root.show-label ? 184px : 36px;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: nav-focus.has-focus ? 1px : 0px;
    border-color: root.accent;
    background: root.selected ? root.accent.with-alpha(0.12) : nav-touch.has-hover ? #ffffff0b : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    forward-focus: nav-focus;
    Rectangle { x: 0px; y: 10px; width: 3px; height: 16px; border-radius: 2px; background: root.selected ? root.accent : transparent; }
    Image { x: 9px; y: 9px; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? root.accent : #a7b8ad; image-fit: contain; }
    if root.show-label : Text { x: 36px; width: parent.width - 40px; height: parent.height; text: root.label; color: root.selected ? #e4ffe9 : #a7b8ad; font-size: 12px; vertical-alignment: center; overflow: elide; }
    nav-focus := FocusScope { changed has-focus => { if self.has-focus { root.hint-changed(root.label, self.absolute-position.y); } else if !nav-touch.has-hover { root.hint-changed("", 0px); } } key-pressed(event) => { if event.text == " " || event.text == "\n" { root.activated(); return accept; } return reject; } }
    nav-touch := TouchArea { clicked => { nav-focus.focus(); root.hint-changed("", 0px); root.activated(); } changed has-hover => { if self.has-hover { root.hint-changed(root.label, self.absolute-position.y); } else { root.hint-changed("", 0px); } } }

}

component PageTitle inherits VerticalBox {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    height: root.subtitle == "" ? 32px : 48px;
    padding: 0px;
    alignment: start;

    Text {
        text: root.title;
        font-family: "Arial";
        color: #effff3;
        font-size: 23px;
        font-weight: 700;
    }
    if root.subtitle != "" : Text {
        text: root.subtitle;
        color: #86a493;
        font-size: 15px;
    }
}

component SectionTitle inherits VerticalBox {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    padding: 0px;
    alignment: start;
    vertical-stretch: 0;

    Text {
        text: root.title;
        color: #e8f9ed;
        font-size: 16px;
        font-weight: 700;
    }
    if root.subtitle != "" : Text {
        text: root.subtitle;
        color: #7f9d8c;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component ColorChoice inherits Rectangle {
    in property <color> choice-color;
    in property <string> label: "Color palette";
    in property <bool> selected: false;
    callback chosen();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }

    width: 34px;
    height: 34px;
    border-radius: 8px;
    border-width: root.selected ? 3px : 1px;
    border-color: palette-focus.has-focus || root.selected ? #ffffff : #52645a;
    background: root.choice-color;
    forward-focus: palette-focus;
    palette-focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.chosen(); return accept; } return reject; } }
    TouchArea { clicked => { palette-focus.focus(); root.chosen(); } }
}

export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "Echo";
    in property <image> application-icon: @image-url("../eleventhecho.png");
    icon: root.application-icon;
    min-width: 760px;
    min-height: 600px;
    preferred-width: 960px;
    preferred-height: 720px;
    default-font-family: "Arial";
    default-font-size: 13px;
    background: @linear-gradient(0deg, root.theme-background-top-color, root.theme-background-bottom-color);

    in-out property <int> active-tab: 0;
    in-out property <int> settings-tab: 0;
    out property <string> navigation-hint;
    property <length> navigation-hint-y;
    in-out property <length> content-scroll-y <=> page-scroll.content-y;
    changed active-tab => {
        page-scroll.content-y = 0px;
        if root.active-tab != 2 { root.selected-activity-bytes = 0; }
    }
    changed settings-tab => { page-scroll.content-y = 0px; }
    in-out property <bool> settings-dirty: false;
    in-out property <bool> unsaved-settings-prompt-visible: false;
    in-out property <int> pending-navigation-tab: 0;

    in property <bool> is-recording: false;
    in property <bool> is-finalizing: false;
    in property <float> audio-level: 0.0;
    in property <string> status-text: "Idle";
    in property <string> hotkey-text: "Ctrl+Space";
    in property <string> assistant-hotkey-text: "Ctrl+Shift+Space";
    in-out property <bool> has-error: false;

    in-out property <string> transcript;
    in-out property <string> transcript-history-text;
    in-out property <string> activity-log-text;
    in-out property <bool> model-loading-notice-visible: false;
    in-out property <int> selected-activity-bytes;
    out property <int> selected-transcript-bytes;

    in-out property <string> api-key-text;
    in-out property <string> elevenlabs-model-text;
    in-out property <string> elevenlabs-language-code-text;
    in-out property <bool> elevenlabs-no-verbatim: true;
    in-out property <string> openai-api-key-text;
    in-out property <string> hugging-face-token-text;
    in-out property <string> openai-model-text;
    in-out property <string> openai-language-code-text;
    in property <[string]> transcription-provider-options;
    in-out property <string> transcription-provider-text;
    in property <[string]> local-model-options;
    in-out property <string> local-model-text;
    private property <bool> local-uses-gpu: root.local-model-text == "Parakeet Ultra — NVIDIA GPU, 25 languages";
    in property <string> ultra-download-description;
    in-out property <string> ultra-gpu-status: "Checking NVIDIA GPU…";
    in-out property <string> local-engine-status-text: "Not loaded";
    in-out property <float> local-cpu-threads: 2;
    in property <float> local-max-cpu-threads: 4;
    in-out property <float> local-vad-threshold: 0.5;
    in-out property <float> local-silence-ms: 1000;
    in-out property <float> local-pre-roll-ms: 250;
    in-out property <float> local-post-roll-ms: 150;
    in-out property <float> local-min-speech-ms: 200;
    in-out property <float> local-max-segment-seconds: 30;
    in-out property <float> local-partial-interval-ms: 1000;
    in-out property <bool> local-redecode-full-session: false;
    in-out property <bool> local-download-prompt-visible: false;
    in-out property <bool> local-download-progress-visible: false;
    in-out property <bool> local-repair-pending: false;
    in-out property <float> local-download-progress: 0;
    in-out property <string> local-download-status: "Preparing local speech model...";
    in-out property <string> local-download-error: "";
    in-out property <string> gemini-api-key-text;
    callback open-model-manager();
    callback manage-components();
    callback manage-agent-tools();
    callback configure-tts();
    callback open-avatar-playground();
    callback open-reminders();
    in-out property <string> tts-model-status;
    in-out property <string> tts-voice-path;
    in property <[string]> tts-voice-options;
    in property <[string]> tts-voice-option-paths;
    in-out property <string> tts-selected-voice;
    callback select-default-voice(string);
    in-out property <bool> tts-preload;
    callback create-model-component();
    callback model-components-changed();
    callback model-component-created(string);
    in property <[string]> microphone-options;
    in-out property <string> selected-microphone;
    in-out property <bool> use-default-microphone: true;
    in property <[string]> speaker-options;
    in-out property <string> selected-speaker;
    in-out property <bool> use-default-speaker: true;
    in-out property <float> output-volume: 1.0;
    callback output-volume-changed(float);
    changed output-volume => { root.output-volume-changed(root.output-volume); }
    in property <bool> speaker-test-running: false;
    in property <string> speaker-test-status;
    callback test-speakers();
    in-out property <bool> keep-microphone-ready: false;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> update-checks-enabled: true;
    in property <bool> updater-configured: false;
    in property <string> app-version: "0.0.0";
    in property <string> cpu-usage-text: "—";
    in property <string> gpu-usage-text: "—";
    in property <string> ram-usage-text: "—";
    in property <string> vram-usage-text: "—";
    in-out property <string> update-available-version: "";
    in-out property <string> update-release-notes: "";
    in-out property <string> update-status: "Updates are checked securely in the background.";
    in-out property <int> update-state: 0;
    in-out property <float> update-progress: 0;
    in-out property <bool> update-panel-visible: false;

    in-out property <float> overlay-opacity: 0.85;
    in-out property <color> theme-background-top-color: #02140b;
    in-out property <color> theme-background-bottom-color: #000806;
    in-out property <color> theme-window-color: #041b11;
    in-out property <color> theme-button-accent-color: #4ade80;
    in-out property <color> theme-title-color: #e4ffe9;
    in-out property <color> theme-text-color: #ccefd6;
    in-out property <color> overlay-background-color: #03150c;
    in-out property <color> overlay-text-color: #e6fff0;
    in-out property <bool> use-gemini-modifier: false;
    in-out property <string> gemini-model-text;
    in-out property <[string]> gemini-preset-options;
    in-out property <string> selected-gemini-preset;
    in-out property <string> gemini-custom-prompt;
    in-out property <bool> post-processing-enabled: true;
    in-out property <bool> post-format-numbers: true;
    in-out property <bool> post-prefer-digits: true;
    in-out property <bool> post-whole-numbers: true;
    in-out property <bool> post-ordinals: true;
    in-out property <bool> post-decimals: true;
    in-out property <bool> post-money: true;
    in-out property <bool> post-measurements: true;
    in-out property <bool> post-dates: true;
    in-out property <bool> post-times: true;
    in-out property <bool> post-identifiers: true;
    in-out property <bool> post-addresses: true;
    in-out property <bool> post-punctuation: true;
    in-out property <bool> post-capitalization: true;
    in-out property <bool> post-commas: true;
    in-out property <bool> post-periods: true;
    in-out property <bool> post-question-marks: true;
    in-out property <bool> post-model-ready: false;
    callback post-processing-changed();
    in-out property <string> post-protected-phrases-text;
    in-out property <string> post-custom-replacements-text;
    in property <string> post-model-status: "Punctuation and capitalization model not downloaded";
    in-out property <bool> post-model-download-prompt-visible: false;
    in-out property <bool> post-model-installing: false;
    in-out property <float> post-model-progress: 0;

    in property <[PipelineRow]> pipeline-rows;
    in property <string> pipeline-error;
    callback graph-node-state(string,string);
    callback sync-graph-hotkeys(string) -> string;
    callback edit-pipeline(int);
    callback use-pipeline(int);
    callback duplicate-pipeline(int);
    callback delete-pipeline(int);
    callback new-pipeline();
    callback new-assistant-pipeline();
    callback hermes-settings();
    callback open-assistant();
    callback apply-settings();
    callback start-hotkey-capture();
    callback start-assistant-hotkey-capture();
    callback accept-local-model-download();
    callback decline-local-model-download();
    callback request-navigation(int);
    callback save-unsaved-settings();
    callback discard-unsaved-settings();
    callback cancel-unsaved-settings();
    callback check-for-updates();
    callback install-update();
    callback download-post-processing-model();
    callback decline-post-processing-model-download();

    // Fixed navigation chrome and footer; only the content pane scrolls.
    VerticalBox {
      padding: 0px; spacing: 0px;
      HorizontalBox {
        padding: 0px; spacing: 0px;
        Rectangle {
            width: root.active-tab == 3 ? 192px : 44px;
            background: root.theme-background-bottom-color;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #ffffff12; }
            VerticalBox {
                y: 0px; padding: 4px; spacing: 3px; alignment: start;
                SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/home.svg"); label: "Transcripts"; selected: root.active-tab == 0; accent: root.theme-button-accent-color; activated => { root.request-navigation(0); } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/activity.svg"); label: "Activity"; selected: root.active-tab == 2; accent: root.theme-button-accent-color; activated => { root.request-navigation(2); } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/settings.svg"); label: "Settings"; selected: root.active-tab == 3; accent: root.theme-button-accent-color; activated => { root.request-navigation(3); } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                if root.active-tab == 3 : VerticalBox {
                    padding: 0px; padding-top: 8px; spacing: 3px; alignment: start;
                    Rectangle { height: 1px; background: #ffffff18; }
                    SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/general.svg"); label: "General"; selected: root.settings-tab == 0; accent: root.theme-button-accent-color; activated => { root.settings-tab = 0; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/speech.svg"); label: "Connections"; selected: root.settings-tab == 1; accent: root.theme-button-accent-color; activated => { root.settings-tab = 1; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: true; icon: @image-url("../assets/icons/speech.svg"); label: "Local speech"; selected: root.settings-tab == 5; accent: root.theme-button-accent-color; activated => { root.settings-tab = 5; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: true; icon: @image-url("../assets/icons/speech.svg"); label: "Punctuation & casing"; selected: root.settings-tab == 3; accent: root.theme-button-accent-color; activated => { root.settings-tab = 3; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: true; icon: @image-url("../assets/icons/speech.svg"); label: "Text to speech"; selected: root.settings-tab == 6; accent: root.theme-button-accent-color; activated => { root.settings-tab = 6; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: true; icon: @image-url("../assets/icons/activity.svg"); label: "Reminders"; selected: false; accent: root.theme-button-accent-color; activated => { root.open-reminders(); } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/rewrite.svg"); label: "Pipelines"; selected: root.settings-tab == 2; accent: root.theme-button-accent-color; activated => { root.settings-tab = 2; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                    SettingsNavItem { show-label: root.active-tab == 3; icon: @image-url("../assets/icons/appearance.svg"); label: "Appearance"; selected: root.settings-tab == 4; accent: root.theme-button-accent-color; activated => { root.settings-tab = 4; } hint-changed(label, y) => { root.navigation-hint = label; root.navigation-hint-y = y; } }
                }
            }
        }
        VerticalBox {
            padding: 0px; spacing: 0px; horizontal-stretch: 1; vertical-stretch: 1;
            HorizontalBox {
                height: root.active-tab == 3 ? 52px : 36px; padding: 4px; spacing: 6px;
                            PageTitle { horizontal-stretch: 1;
                title: root.active-tab == 0 ? "Transcripts" : root.active-tab == 2 ? "Activity" : "Settings";
                subtitle: root.active-tab != 3 ? "" : root.settings-tab == 1 ? "Connections" : root.settings-tab == 2 ? "Pipelines" : root.settings-tab == 3 ? "Punctuation & capitalization" : root.settings-tab == 5 ? "Local speech models" : root.settings-tab == 6 ? "Text to speech" : root.settings-tab == 4 ? "Appearance" : "General";
            }
            }
            page-scroll := ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 4px; padding-right: 18px; spacing: 6px; alignment: start;
                    if root.active-tab == 0 : VerticalBox {
                        padding: 0px; spacing: 6px; alignment: start;
                        if root.has-error : Text { text: root.status-text; color: #fda4af; wrap: word-wrap; font-size: 12px; }
                        Rectangle {
                            height: Math.max(transcript-text.preferred-height + 12px, page-scroll.height - 8px);
                            border-radius: 6px; background: root.theme-window-color; border-width: 1px; border-color: #ffffff18;
                            transcript-text := SelectableDocument {
                                selected-bytes <=> root.selected-transcript-bytes;
                                x: 6px; y: 6px; width: parent.width - 12px; height: self.preferred-height;
                                text: root.transcript-history-text;
                                read-only: true; single-line: false; wrap: word-wrap;
                                font-size: 14px; color: root.theme-text-color;
                                accessible-label: "Transcript history";
                            }
                        }
                    }
                    if root.active-tab == 2 : Rectangle {
                        height: Math.max(activity-text.preferred-height + 12px, page-scroll.height - 8px);
                        border-radius: 6px; background: root.theme-window-color; border-width: 1px; border-color: #ffffff18;
                        activity-text := SelectableDocument { selected-bytes <=> root.selected-activity-bytes; x: 6px; y: 6px; width: parent.width - 12px; height: self.preferred-height; text: root.activity-log-text; font-size: 14px; color: root.theme-text-color; accessible-label: "Activity log"; }
                    }
                    if root.active-tab == 3 : VerticalBox {
                        padding: 2px; spacing: 6px; alignment: start;
                        if root.settings-tab == 0 : VerticalBox { alignment: start; padding: 0px;
                            spacing: 10px;
                            SectionTitle { title: "Audio and shortcuts"; subtitle: "Choose your microphone, speakers, and recording shortcuts."; }
                            Text { text: "Microphone"; color: #d6e9dc; font-size: 12px; font-weight: 600; }
                            ComboBox { height: 32px; min-width: 0px;
                                model: root.microphone-options;
                                current-value <=> root.selected-microphone;
                                selected(value) => {
                                    root.selected-microphone = value;
                                    root.use-default-microphone = false;
                                }
                            }
                            CheckBox { height: 26px; text: "Follow the Windows default microphone"; checked <=> root.use-default-microphone; }
                            CheckBox { height: 26px; text: "Keep microphone active for instant start"; checked <=> root.keep-microphone-ready; }
                            Text {
                                text: "Windows will show the microphone as in use while Echo is running. Echo keeps only the latest 0.5 seconds in memory and sends nothing until transcription starts.";
                                color: #9cafa5;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: #1c3a2a; }
                            Text { text: "Speakers"; color: #d6e9dc; font-size: 12px; font-weight: 600; }
                            ComboBox { height: 32px; min-width: 0px;
                                model: root.speaker-options;
                                current-value <=> root.selected-speaker;
                                selected(value) => {
                                    root.selected-speaker = value;
                                    root.use-default-speaker = false;
                                }
                            }
                            CheckBox { height: 26px; text: "Follow the Windows default speakers"; checked <=> root.use-default-speaker; }
                            HorizontalBox {
                                Text { text: "Speech volume"; color: #e6fff0; vertical-alignment: center; }
                                Slider { minimum: 0; maximum: 100; value: root.output-volume * 100; accessible-label: "Speech volume"; changed(value) => { root.output-volume = round(value) / 100; } }
                                Text { text: round(root.output-volume * 100) + "%"; color: #e6fff0; width: 45px; vertical-alignment: center; }
                            }
                            ActionButton { text: root.speaker-test-running ? "Playing test…" : "Test speakers"; enabled: !root.speaker-test-running; clicked => { root.test-speakers(); } }
                            Text { text: "Assistant speech and voice previews use these speakers. Changes apply to the next playback after saving."; color: #9cafa5; font-size: 12px; wrap: word-wrap; }
                            if root.speaker-test-status != "" : Text { text: root.speaker-test-status; color: #a7f3d0; font-size: 12px; wrap: word-wrap; }
                            Rectangle { height: 1px; background: #1c3a2a; }
                            Text { text: "Assign a hotkey to each graph in Pipelines."; color:#9cafa5; font-size:12px; }
                            CheckBox { height: 26px; text: "Start Echo when I sign in to Windows"; checked <=> root.start-with-windows; }

                            Rectangle { height: 1px; background: #1c3a2a; }
                            SectionTitle { title: "Updates"; subtitle: "Echo verifies update manifests and installers before installation."; }
                            CheckBox { height: 26px; text: "Automatically check for updates"; checked <=> root.update-checks-enabled; enabled: root.updater-configured; }
                            HorizontalBox { padding: 0px;
                                spacing: 10px;
                                ActionButton { accent: root.theme-button-accent-color; text: root.update-state == 1 ? "Checking…" : "Check now"; enabled: root.updater-configured && root.update-state != 1 && root.update-state != 3; clicked => { root.check-for-updates(); } }
                                Text { text: root.updater-configured ? "Current version " + root.app-version : "Updates are disabled in this development build."; color: #9cafa5; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                        if root.settings-tab == 1 : VerticalBox { padding: 0px; spacing: 10px; alignment: start;
                            SectionTitle { title: "Connections"; subtitle: "Credentials for online transcription and text models."; }
                            Text { text: "ElevenLabs API key"; color: #a9c3b2; } LineEdit { text <=> root.api-key-text; input-type: password; }
                            Text { text: "OpenAI API key"; color: #a9c3b2; } LineEdit { text <=> root.openai-api-key-text; input-type: password; }
                            ActionButton { text: "Manage text models"; clicked => { root.open-model-manager(); } }
                            ActionButton { text: "Hermes assistant settings"; clicked => { root.hermes-settings(); } }
                            ActionButton { text: "Open assistant"; clicked => { root.open-assistant(); } }
                            ActionButton { text: "Tools, search & MCP servers"; clicked => { root.manage-agent-tools(); } }
                            ActionButton { text: "Install or manage components"; clicked => { root.manage-components(); } }
                        }
                        if root.settings-tab == 5 : VerticalBox { padding: 0px; spacing: 10px; alignment: start;
                            SectionTitle { title: "Local speech models"; subtitle: "Parakeet v2, v3, and Ultra. These defaults apply to newly added transcription nodes; configure existing nodes in their graph."; }
                            Text { text: "Speech model"; color: #a9c3b2; }
                            ComboBox { model: root.local-model-options; current-value <=> root.local-model-text; enabled: !root.is-recording && !root.is-finalizing && !root.local-download-progress-visible; accessible-label: "Local speech model"; }
                            Text { text: root.local-engine-status-text; color: #a9c3b2; wrap: word-wrap; }
                            if root.local-uses-gpu : Text { text: root.ultra-gpu-status; color: #a9c3b2; wrap: word-wrap; }
                            ActionButton { text: "Install / repair speech model"; enabled: !root.is-recording && !root.is-finalizing && !root.local-download-progress-visible; clicked => { root.local-download-error = ""; root.local-download-prompt-visible = true; } }
                            if !root.local-uses-gpu : VerticalBox { padding: 0px; spacing: 8px;
                                Text { text: "CPU threads: " + round(root.local-cpu-threads); color: #a9c3b2; }
                                Slider { value <=> root.local-cpu-threads; changed(value) => { root.local-cpu-threads = round(value); } minimum: 1; maximum: root.local-max-cpu-threads; accessible-label: "CPU threads"; }
                                Text { text: "Speech detection threshold (%): " + round(root.local-vad-threshold * 100); color: #a9c3b2; }
                                Slider { value: root.local-vad-threshold * 100; changed(value) => { root.local-vad-threshold = round(value) / 100; } minimum: 10; maximum: 90; accessible-label: "Speech detection threshold (%)"; }
                                Text { text: "Silence before completing a segment (ms): " + round(root.local-silence-ms); color: #a9c3b2; }
                                Slider { value <=> root.local-silence-ms; changed(value) => { root.local-silence-ms = round(value / 1000) * 1000; } minimum: 1000; maximum: 10000; accessible-label: "Silence before completing a segment (ms)"; }
                                Text { text: "Audio before speech (ms): " + round(root.local-pre-roll-ms); color: #a9c3b2; }
                                Slider { value <=> root.local-pre-roll-ms; changed(value) => { root.local-pre-roll-ms = round(value); } minimum: 0; maximum: 1000; accessible-label: "Audio before speech (ms)"; }
                                Text { text: "Audio after speech (ms): " + round(root.local-post-roll-ms); color: #a9c3b2; }
                                Slider { value <=> root.local-post-roll-ms; changed(value) => { root.local-post-roll-ms = round(value); } minimum: 0; maximum: 1000; accessible-label: "Audio after speech (ms)"; }
                                Text { text: "Minimum speech duration (ms): " + round(root.local-min-speech-ms); color: #a9c3b2; }
                                Slider { value <=> root.local-min-speech-ms; changed(value) => { root.local-min-speech-ms = round(value); } minimum: 50; maximum: 2000; accessible-label: "Minimum speech duration (ms)"; }
                                Text { text: "Maximum segment duration (seconds): " + round(root.local-max-segment-seconds); color: #a9c3b2; }
                                Slider { value <=> root.local-max-segment-seconds; changed(value) => { root.local-max-segment-seconds = round(value); } minimum: 5; maximum: 120; accessible-label: "Maximum segment duration (seconds)"; }
                                Text { text: "Partial transcript interval (ms): " + round(root.local-partial-interval-ms); color: #a9c3b2; }
                                Slider { value <=> root.local-partial-interval-ms; changed(value) => { root.local-partial-interval-ms = round(value); } minimum: 250; maximum: 5000; accessible-label: "Partial transcript interval (ms)"; }
                                CheckBox { text: "Re-decode the full recording for final transcription"; checked <=> root.local-redecode-full-session; }
                            }
                        }
                        if root.settings-tab == 3 : VerticalBox { padding: 0px; spacing: 10px; alignment: start;
                            SectionTitle { title: "Offline punctuation & capitalization"; subtitle: "Edge Punct Casing restores punctuation and casing locally. These defaults apply to newly added punctuation nodes."; }
                            Text { text: root.post-model-status; color: #a9c3b2; wrap: word-wrap; }
                            ActionButton { text: "Install / repair punctuation model"; enabled: !root.is-recording && !root.is-finalizing && !root.post-model-installing; clicked => { root.post-model-download-prompt-visible = true; } }
                            CheckBox { text: "Add punctuation"; checked <=> root.post-punctuation; }
                            CheckBox { text: "Restore capitalization"; checked <=> root.post-capitalization; }
                            CheckBox { text: "Commas"; checked <=> root.post-commas; enabled: root.post-punctuation; }
                            CheckBox { text: "Periods"; checked <=> root.post-periods; enabled: root.post-punctuation; }
                            CheckBox { text: "Question marks"; checked <=> root.post-question-marks; enabled: root.post-punctuation; }
                        }
                        if root.settings-tab == 6 : VerticalBox { padding: 0px; spacing: 10px; alignment: start;
                            SectionTitle { title: "Pocket TTS"; subtitle: "Generate speech locally with the standard Alba voice. Optionally import or record a custom voice, and test your own phrase."; }
                            Text { text: "Hugging Face token (required for model installation)"; color: #a9c3b2; wrap: word-wrap; }
                            LineEdit { text <=> root.hugging-face-token-text; input-type: password; }
                            Text { text: "The standard Alba voice needs no token. For custom voice import, install Custom voice import under Connections → Install or manage components. Playback uses the speakers selected in General."; color: #9cafa5; wrap: word-wrap; font-size: 12px; }
                            Text { text: root.tts-model-status; color: #a9c3b2; wrap: word-wrap; }
                            Text { text: root.tts-voice-path == "" ? "Standard voice: Alba" : root.tts-voice-path; color: #a9c3b2; wrap: word-wrap; }
                            Text { text: "Default voice"; color: #a9c3b2; }
                            ComboBox { model: root.tts-voice-options; current-value <=> root.tts-selected-voice; accessible-label: "Default speech voice"; selected(value) => { root.select-default-voice(value); } }
                            ActionButton { text: "Manage voices / test speech"; clicked => { root.configure-tts(); } }
                            ActionButton { text: "Avatar creation & playground"; clicked => { root.open-avatar-playground(); } }
                            Text { text: "Speech nodes follow this default unless you select a voice directly on the node. Save settings to keep this default."; color: #9cafa5; wrap: word-wrap; font-size: 12px; }
                        }
                        if root.settings-tab == 2 : PipelineList {
                            rows: root.pipeline-rows; error: root.pipeline-error;
                            edit(index) => { root.edit-pipeline(index); }
                            use-pipeline(index) => { root.use-pipeline(index); }
                            duplicate(index) => { root.duplicate-pipeline(index); }
                            delete-pipeline(index) => { root.delete-pipeline(index); }
                            new-pipeline => { root.new-pipeline(); }
                            new-assistant => { root.new-assistant-pipeline(); }
                        }
                        if root.settings-tab == 4 : VerticalBox { alignment: start; padding: 0px;
                            spacing: 10px;
                            Text { text: "Color palette"; color: #d6e9dc; font-size: 12px; font-weight: 600; }
                            HorizontalBox { padding: 0px;
                                spacing: 10px;
                                ColorChoice {
                                    label: "Forest green palette"; choice-color: #4ade80; selected: root.theme-button-accent-color == #4ade80;
                                    chosen => { root.theme-background-top-color=#02140b; root.theme-background-bottom-color=#000806; root.theme-window-color=#041b11; root.theme-button-accent-color=#4ade80; root.theme-title-color=#e4ffe9; root.theme-text-color=#ccefd6; root.overlay-background-color=#03150c; root.overlay-text-color=#e6fff0; }
                                }
                                ColorChoice {
                                    label: "Ocean blue palette"; choice-color: #38bdf8; selected: root.theme-button-accent-color == #38bdf8;
                                    chosen => { root.theme-background-top-color=#071523; root.theme-background-bottom-color=#030811; root.theme-window-color=#091b2a; root.theme-button-accent-color=#38bdf8; root.theme-title-color=#e0f2fe; root.theme-text-color=#c7e8f8; root.overlay-background-color=#061827; root.overlay-text-color=#e0f2fe; }
                                }
                                ColorChoice {
                                    label: "Violet palette"; choice-color: #a78bfa; selected: root.theme-button-accent-color == #a78bfa;
                                    chosen => { root.theme-background-top-color=#170f27; root.theme-background-bottom-color=#08050f; root.theme-window-color=#1a1029; root.theme-button-accent-color=#a78bfa; root.theme-title-color=#f1eaff; root.theme-text-color=#ded2f6; root.overlay-background-color=#160d24; root.overlay-text-color=#f1eaff; }
                                }
                                ColorChoice {
                                    label: "Rose palette"; choice-color: #fb7185; selected: root.theme-button-accent-color == #fb7185;
                                    chosen => { root.theme-background-top-color=#251015; root.theme-background-bottom-color=#0e0507; root.theme-window-color=#281217; root.theme-button-accent-color=#fb7185; root.theme-title-color=#fff1f2; root.theme-text-color=#f7d4d9; root.overlay-background-color=#240e14; root.overlay-text-color=#fff1f2; }
                                }
                            }
                            Rectangle { height: 1px; background: #1c3a2a; }
                            Text { text: "Overlay opacity: " + root.overlay-opacity; color: #d6e9dc; font-size: 12px; font-weight: 600; }
                            Slider { minimum: 0.3; maximum: 1.0; value <=> root.overlay-opacity; }
                            Text { text: "The overlay remains movable and always on top while transcription is active."; color: #9cafa5; font-size: 12px; wrap: word-wrap; }

                            Rectangle {
                                height: 116px; border-radius: 10px; background: root.theme-window-color; border-width: 1px; border-color: #244534;
                                Text { x: 14px; y: 12px; text: "Overlay preview"; color: #9cafa5; font-size: 12px; }
                                Rectangle {
                                    x: 14px; y: 35px; width: parent.width - 28px; height: 64px; border-radius: 8px;
                                    background: root.overlay-background-color; opacity: root.overlay-opacity; border-width: 1px; border-color: #3b5848;
                                    Text { x: 12px; y: 10px; text: "Live"; color: root.theme-button-accent-color; font-size: 12px; }
                                    Text { x: 12px; y: 29px; text: "Your words will appear here as you speak."; color: root.overlay-text-color; font-size: 12px; }
                                }
                            }
                        }
                VerticalBox {
                    padding: 0px; spacing: 10px; vertical-stretch: 0;
                    Rectangle { height: 1px; background: #ffffff18; }
                    HorizontalBox {
                        padding: 0px; spacing: 12px;
                        Text { min-width: 0px; horizontal-stretch: 1; overflow: elide; text: root.settings-dirty ? "Unsaved changes" : "All changes saved"; color: root.settings-dirty ? root.theme-button-accent-color : #94a3b8; font-size: 12px; vertical-alignment: center; }
                        ActionButton { text: "Save settings"; primary: true; accent: root.theme-button-accent-color; enabled: !root.is-recording && !root.is-finalizing && !root.local-download-progress-visible; clicked => { root.apply-settings(); } }
                    }
                }
                    }
                }
            }
        }
    }

      Rectangle {
        height: 26px; vertical-stretch: 0;
        background: root.theme-background-bottom-color;
        Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: #ffffff18; }
        HorizontalBox {
          padding-left: 8px; padding-right: 8px; padding-top: 1px; padding-bottom: 1px; spacing: 16px;
          VersionLink { text: "v" + root.app-version + (root.update-available-version == "" ? "" : " · Update"); accent: root.theme-button-accent-color; clicked => { root.update-panel-visible = true; } }
          Rectangle { horizontal-stretch: 1; background: transparent; }
          ResourceValue { label: "CPU"; value: root.cpu-usage-text; }
          ResourceValue { label: "GPU"; value: root.gpu-usage-text; }
          ResourceValue { label: "RAM"; value: root.ram-usage-text; }
          ResourceValue { label: "VRAM"; value: root.vram-usage-text; }
        }
      }
    }

    if root.navigation-hint != "" && !root.update-panel-visible && !root.unsaved-settings-prompt-visible && !root.local-download-prompt-visible && !root.local-download-progress-visible && !root.post-model-download-prompt-visible && !root.post-model-installing : Rectangle {
        x: 48px; y: root.navigation-hint-y;
        width: hint-text.preferred-width + 16px; height: 32px;
        border-radius: 4px; background: #173b2a; border-color: #589970; border-width: 1px;
        accessible-role: none;
        hint-text := Text { x: 8px; height: parent.height; text: root.navigation-hint; color: #edfff2; font-size: 12px; vertical-alignment: center; }
    }

    if root.update-panel-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #000000b8;
        TouchArea { clicked => {} }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: dialog0.preferred-height;
            background: root.theme-window-color;
            border-color: root.update-state == 4 ? #7f3345 : #2a5a40;
            border-width: 1px;
            border-radius: 14px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;

            dialog0 := VerticalBox { alignment: start;
                padding: 20px;
                spacing: 13px;
                Text { text: root.update-available-version == "" ? "Echo updates" : "Echo " + root.update-available-version + " is available"; color: #edfff2; font-size: 19px; wrap: word-wrap; font-weight: 700; }
                Text { text: "Installed version: " + root.app-version; color: #91aa9b; font-size: 11px; }
                Text { text: root.update-status; color: root.update-state == 4 ? #fda4af : #b7d2bf; wrap: word-wrap; font-size: 12px; }
                if root.update-release-notes != "" : Rectangle {
                    height: 80px; border-radius: 8px; background: root.theme-window-color; border-width: 1px; border-color: #1c3a2a; clip: true;
                    ScrollView { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px;
                        Text { text: root.update-release-notes; color: #a9c3b2; wrap: word-wrap; font-size: 12px; }
                    }
                }
                if root.update-state == 3 : Rectangle {
                    height: 8px; border-radius: 4px; background: root.theme-window-color; clip: true;
                    Rectangle { width: parent.width * root.update-progress; height: parent.height; border-radius: 4px; background: root.theme-button-accent-color; }
                }
                HorizontalBox { height: 32px; padding: 0px; alignment: end;
                    spacing: 10px;
                    if root.update-available-version != "" && root.update-state != 1 && root.update-state != 3 : ActionButton { accent: root.theme-button-accent-color; text: root.update-state == 4 ? "Retry" : "Install now"; primary: true; clicked => { root.install-update(); } }
                    if root.update-available-version == "" && root.update-state != 1 : ActionButton { accent: root.theme-button-accent-color; text: "Check now"; primary: true; enabled: root.updater-configured; clicked => { root.check-for-updates(); } }
                    ActionButton { accent: root.theme-button-accent-color; text: "Later"; enabled: root.update-state != 3; clicked => { root.update-panel-visible = false; } }
                }
            }
        }
    }

    if (root.local-download-prompt-visible || root.local-download-progress-visible) && !root.update-panel-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #000000b8;
        TouchArea { clicked => {} }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 540px;
            height: dialog1.preferred-height;
            background: root.theme-window-color;
            border-color: #2a5a40;
            border-width: 1px;
            border-radius: 14px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;

            dialog1 := VerticalBox { alignment: start;
                padding: 20px;
                spacing: 13px;
                Text { text: root.local-download-progress-visible ? "Installing local speech" : "Install local speech files?"; color: #edfff2; font-size: 19px; wrap: word-wrap; font-weight: 700; }
                if root.local-download-prompt-visible && root.local-download-error != "" : Text { text: root.local-download-error; color: #fda4af; wrap: word-wrap; }
                Text {
                    text: root.local-download-progress-visible ? root.local-download-status : root.local-uses-gpu ? root.ultra-download-description : "Selected: " + root.local-model-text + ". About 465 MB will be downloaded; Echo verifies the pinned SHA-256 before installing Parakeet and Silero.";
                    color: #a9c3b2; wrap: word-wrap; font-size: 12px;
                }
                if root.local-download-progress-visible : Rectangle {
                    height: 14px; background: root.theme-window-color; border-radius: 7px;
                    Rectangle { width: parent.width * Math.max(0, Math.min(1, root.local-download-progress)); height: parent.height; background: root.theme-button-accent-color; border-radius: 7px; animate width { duration: 100ms; } }
                }
                if !root.local-download-progress-visible : HorizontalBox { height: 32px; padding: 0px; alignment: end;
                    spacing: 10px;
                    ActionButton { accent: root.theme-button-accent-color; text: "Download and install"; primary: true; clicked => { root.accept-local-model-download(); } }
                    ActionButton { accent: root.theme-button-accent-color; text: "Not now"; clicked => { root.decline-local-model-download(); } }
                }
            }
        }
    }

    if root.unsaved-settings-prompt-visible && !root.update-panel-visible : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #000000b8;
        TouchArea { clicked => {} }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: dialog2.preferred-height;
            background: root.theme-window-color;
            border-color: #2a5a40;
            border-width: 1px;
            border-radius: 14px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;

            dialog2 := VerticalBox { alignment: start;
                padding: 20px;
                spacing: 14px;
                Text { text: "Save settings changes?"; color: #edfff2; font-size: 19px; wrap: word-wrap; font-weight: 700; }
                Text { text: "You changed one or more settings. Save them before leaving this page?"; color: #a9c3b2; wrap: word-wrap; font-size: 12px; }
                HorizontalBox { height: 32px; padding: 0px; alignment: end;
                    spacing: 10px;
                    ActionButton { accent: root.theme-button-accent-color; text: "Save"; primary: true; clicked => { root.save-unsaved-settings(); } }
                    ActionButton { accent: root.theme-button-accent-color; text: "Don't save"; clicked => { root.discard-unsaved-settings(); } }
                    ActionButton { accent: root.theme-button-accent-color; text: "Cancel"; clicked => { root.cancel-unsaved-settings(); } }
                }
            }
        }
    }

    if root.post-model-download-prompt-visible || root.post-model-installing : Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: #000000b8;
        TouchArea { clicked => {} }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 500px; height: dialog3.preferred-height; background: root.theme-window-color; border-color: #2a5a40; border-width: 1px; border-radius: 14px;
            dialog3 := VerticalBox { alignment: start;
                padding: 20px; spacing: 14px;
                Text { text: root.post-model-installing ? "Installing punctuation and capitalization model" : root.post-model-ready ? "Ready to use" : "Install punctuation and capitalization model?"; color: #edfff2; font-size: 19px; wrap: word-wrap; font-weight: 700; }
                Text { text: "Post-processing uses a local 7.6 MB CPU model. Echo downloads a 30 MB package over HTTPS and verifies its SHA-256 before installing it."; color: #a9c3b2; wrap: word-wrap; font-size: 12px; }
                VerticalBox { alignment: start; spacing: 7px;
                    Text { text: root.post-model-status; color: #a9c3b2; font-size: 11px; wrap: word-wrap; }
                    Rectangle { height: 14px; background: root.theme-window-color; border-radius: 7px; Rectangle { width: parent.width * Math.max(0, Math.min(1, root.post-model-progress)); height: parent.height; background: root.theme-button-accent-color; border-radius: 7px; animate width { duration: 100ms; } } }
                }
                if !root.post-model-installing : HorizontalBox { height: 32px; padding: 0px; alignment: end; spacing: 10px;
                    if !root.post-model-ready : ActionButton { accent: root.theme-button-accent-color; text: "Download and install"; primary: true; enabled: !root.is-recording && !root.is-finalizing; clicked => { root.download-post-processing-model(); } }
                    ActionButton { accent: root.theme-button-accent-color; text: root.post-model-ready ? "Done" : "Not now"; clicked => { root.post-model-download-prompt-visible = false; root.decline-post-processing-model-download(); } }
                }
            }
        }
    }

}

export component HotkeyCaptureWindow inherits Window {
    default-font-family: "Arial";
    title: "Capture Hotkey";
    in property <image> application-icon: @image-url("../eleventhecho.png");
    icon: root.application-icon;
    width: 390px;
    height: 190px;
    background: #07140e;

    in property <string> state-text: "Waiting for key combo...";
    in property <string> combo-text: "";

    Rectangle {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        border-radius: 12px; background: #0b2117; border-width: 1px; border-color: #28513a;
        VerticalBox { alignment: start;
            padding: 20px; spacing: 12px;
            Text { text: "Press your shortcut"; color: #effff3; font-size: 19px; font-weight: 700; }
            Text { text: root.state-text; color: #91aa9b; wrap: word-wrap; }
            Text { text: root.combo-text == "" ? "Waiting…" : root.combo-text; color: #4ade80; font-size: 18px; font-weight: 700; }
        }
    }
}

export component TranscriptOverlayWindow inherits Window {
    default-font-family: "Arial";
    title: "Echo Live";
    // Animate content, never the native icon of this frameless window:
    // WM_SETICON can repaint non-client chrome on Windows.
    in property <image> recording-indicator: @image-url("../eleventhecho.png");
    icon: @image-url("../eleventhecho.png");
    no-frame: true;
    always-on-top: true;
    width: 560px;
    height: root.window-height * 1px;
    background: transparent;

    // Width remains fixed; captions grow to the overlay limit, then scroll.
    in property <int> window-width: 560;
    in property <int> window-height: 106;
    in property <string> sentence-text: "";
    in property <string> microphone-name: "Microphone";
    in property <float> overlay-opacity: 0.85;
    in property <float> audio-level: 0.0;
    in property <color> overlay-background-color: #0d1017;
    in property <color> overlay-text-color: #ffffff;
    in property <bool> is-error: false;
    in property <bool> is-system-message: false;
    in property <bool> is-visible: false;

    in property <[PipelineCard]> pipeline-cards;
    in property <string> graph-status;
    in property <[GraphRunRow]> graph-run-nodes;
    in property <[GraphRunRow]> graph-progress-nodes;
    private property <bool> has-progress: root.pipeline-cards.length > 0 || root.graph-run-nodes.length > 0;
    in property <string> pipeline-name;
    in property <int> pipeline-step: 0;
    in property <bool> pipeline-failed: false;
    in property <string> failure-message;
    in property <bool> step-complete: false;
    out property <float> caption-required-height: (root.has-progress ? 132 : 86) + Math.max(24, caption.preferred-height / 1px) + (root.pipeline-failed ? 80 : 0);
    callback caption-layout-changed();
    changed caption-required-height => { root.caption-layout-changed(); }
    callback copy-result();
    callback dismiss-result();
    callback move-window(int, int);

    TouchArea {
        moved => {
            if self.pressed {
                root.move-window((self.mouse-x - self.pressed-x) / 1px, (self.mouse-y - self.pressed-y) / 1px);
            }
        }
        Rectangle {
            x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.is-error ? #fb7185 : #356047;
            background: (root.is-error ? #2b0b14 : root.overlay-background-color).with-alpha(root.overlay-opacity);

            // Compact title row: active state and actual input device.
            Rectangle {
                x: 16px; y: 12px; width: 20px; height: 20px;
                border-radius: 10px;
                background: root.is-error ? #5a1827 : #123b27;
                Image {
                    x: 0px; y: 0px; width: 20px; height: 20px;
                    source: root.recording-indicator;
                    image-fit: contain;
                }
            }

            Text {
                x: 44px; y: 12px; width: 80px; height: 20px;
                text: root.is-error ? "Issue" : root.is-system-message ? "Echo" : root.pipeline-step > 0 ? "Processing" : "Listening on";
                color: root.is-error ? #fda4af : #4ade80;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                x: 124px; y: 12px; width: parent.width - 140px; height: 20px;
                text: root.graph-status != "" ? root.graph-status : root.pipeline-failed ? "Pipeline stopped · " + root.pipeline-name : root.pipeline-name == "" ? root.microphone-name : root.pipeline-name + " · " + root.microphone-name;
                color: root.is-error ? #fecdd3 : #91aa9b;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            Rectangle {
                x: 16px; y: 37px; width: parent.width - 32px; height: 1px;
                background: root.is-error ? #713144 : #294636;
            }

            if root.pipeline-cards.length > 0 : ScrollView {
                x: 16px; y: 43px; width: parent.width - 32px; height: 38px;
                content-x: root.pipeline-cards.length * 34px + 116px > self.width ? -Math.max(0px, Math.min(root.pipeline-step * 34px - (self.width - 146px) / 2, root.pipeline-cards.length * 34px + 116px - self.width)) : 0px;
                HorizontalBox { spacing: 4px; padding: 0px; alignment: start;
                    for card[index] in root.pipeline-cards : step-card := Rectangle {
                        property <bool> current: index == root.pipeline-step;
                        property <bool> label-visible: self.current || root.pipeline-cards.length * 150px < root.width - 40px;
                        width: self.label-visible ? 146px : 30px; height: 32px; border-radius: 5px;
                        background: self.current ? root.pipeline-failed ? #5a1827 : #205837 : #ffffff08;
                        border-width: 1px; border-color: self.current ? root.pipeline-failed ? #fb7185 : #4ade80 : index < root.pipeline-step ? #356047 : #ffffff12;
                        Image { x: 5px; y: 7px; width: 20px; height: 20px; source: card.icon; colorize: index < root.pipeline-step || (parent.current && root.step-complete) ? #4ade80 : #edfff2; }
                        if step-card.label-visible : Text { x: 31px; width: parent.width - 36px; height: parent.height; text: card.title; color: #edfff2; font-size: 10px; overflow: elide; vertical-alignment: center; }
                    }
                }
            }
            if root.graph-run-nodes.length > 0 : GraphRunProgress {
                x: 16px; y: 43px; width: parent.width - 32px; nodes: root.graph-progress-nodes;
            }
            // Measure wrapped text; retain the full transcript in a scrollable viewport.
            caption-scroll := ScrollView {
                content-height: caption.preferred-height;
                content-y: -Math.max(0px, self.content-height - self.visible-height);
                x: 16px; y: root.has-progress ? 91px : 45px; width: parent.width - 32px;
                height: Math.max(24px, parent.height - self.y - (root.pipeline-failed ? 112px : 32px));
                caption := Text {
                    width: caption-scroll.width - 12px; height: self.preferred-height;
                    accessible-label: "Live transcript";
                    text: root.sentence-text;
                    color: root.is-error ? #ffe4e6 : root.is-system-message ? #a7f3d0 : root.overlay-text-color;
                    font-size: 15px; font-weight: 500; wrap: word-wrap;
                    vertical-alignment: top;
                }
            }

            Rectangle {
                visible: !root.pipeline-failed;
                x: 16px; y: parent.height - 26px; width: parent.width - 32px; height: 1px;
                background: root.is-error ? #713144 : #294636;
            }

            // Speech-responsive level row shared with the main window.
            Rectangle {
                visible: !root.pipeline-failed;
                x: 16px; y: parent.height - 17px; width: parent.width - 32px; height: 5px;
                border-radius: 3px;
                background: root.is-error ? #4b1724 : #183025;
                Rectangle {
                    width: parent.width * Math.max(0, Math.min(1, root.audio-level));
                    height: parent.height;
                    border-radius: 3px;
                    background: root.is-error ? #fb7185 : #4ade80;
                    animate width { duration: 60ms; }
                }
            }
        }
    }
    if root.pipeline-failed : Text { x: 16px; y: root.height - 78px; width: root.width - 32px; height: 28px; text: root.failure-message; color: #fda4af; overflow: elide; font-size: 11px; }
    if root.pipeline-failed : HorizontalBox { x: 16px; y: root.height - 48px; width: root.width - 32px; height: 40px; spacing: 8px;
        ActionButton { text: "Copy last result"; clicked => { root.copy-result(); } }
        ActionButton { text: "Dismiss"; clicked => { root.dismiss-result(); } }
    }

}
import { CodexImportWindow, CodexConversationRow, CodexPreviewRow } from "codex_import.slint";
export { CodexImportWindow, CodexConversationRow, CodexPreviewRow }
